# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/driving_school?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# --- App ---
NODE_ENV="development"
PORT=4000
APP_TIMEZONE="Asia/Jerusalem"
FRONTEND_ORIGIN="http://localhost:5173"

# --- Initial admin/teacher account (used only by the seed script, Phase 1) ---
# Leave blank to have the seed script generate a random password and print
# it once to the console instead.
INITIAL_ADMIN_PHONE=""
INITIAL_ADMIN_PASSWORD=""
